owner       = "your-name"
cost_center = "portfolio"

# Set these overrides before importing existing live resources so Terraform
# adopts the current names instead of proposing replacements.
bucket_name_overrides = {
  raw            = "streamforge-raw-ACCOUNTID-us-east-1"
  clean          = "streamforge-clean-ACCOUNTID-us-east-1"
  rejected       = "streamforge-rejected-ACCOUNTID-us-east-1"
  metadata       = "streamforge-metadata-ACCOUNTID-us-east-1"
  curated        = "streamforge-curated-ACCOUNTID-us-east-1"
  quarantine     = "streamforge-quarantine-ACCOUNTID-us-east-1"
  athena_results = "streamforge-athena-results-ACCOUNTID-us-east-1"
}

# Set this to the existing key alias or adopt the new default alias.
kms_alias_name = "alias/streamforge-phase1"
kms_description = "StreamForge Phase 1 S3 encryption key"

# Keep these aligned with the currently deployed Phase 1 runtime resources when
# adopting an existing environment.
lambda_function_name = "streamforge-processor"
lambda_description   = ""
lambda_role_name     = "streamforge-lambda-role"
lambda_inline_policy_name = "streamforge-s3-kms"
event_rule_name      = "streamforge-raw-uploads"
event_rule_description = ""

# Keep these aligned with the currently deployed Phase 2 analytics resources
# when adopting an existing environment.
glue_database_name = "streamforge_clean_db"
glue_crawler_role_name = "streamforge-glue-crawler-role"
glue_crawler_inline_policy_name = "streamforge-glue-clean-read"
glue_crawler_name = "streamforge-clean-crawler"
athena_workgroup_name = "streamforge-phase2"

# Keep these aligned with the currently deployed Phase 3 curated analytics
# resources when adopting an existing environment.
phase3_glue_job_role_name = "streamforge-glue-transform-role"
phase3_glue_job_inline_policy_name = "streamforge-phase3-data-access"
phase3_glue_job_name = "streamforge-transform-customers"
phase3_athena_workgroup_name = "streamforge-phase3"
phase3_curated_table_name = "customers_curated"

# Track B creates the alerting subscription when this optional value is set.
# The recipient must confirm the subscription email after Terraform applies.
operations_alert_email = "you@example.com"

# Phase 5 serving layer. Defaults are sensible for a dev demo; override ACU
# bounds to control Aurora Serverless v2 cost. The loader package is built by
# scripts/package_lambdas.py --include-loader.
phase5_db_name             = "streamforge"
phase5_serverless_min_acu  = 0.5
phase5_serverless_max_acu  = 4
phase5_loader_function_name = "streamforge-database-loader"
phase5_loader_role_name    = "streamforge-database-loader-role"
phase5_event_rule_name     = "streamforge-curated-loads"
